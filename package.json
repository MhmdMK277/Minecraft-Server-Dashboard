{
  "name": "minecraft-server-dashboard",
  "version": "0.1.0",
  "description": "Attach-model dashboard for Minecraft servers started outside the app",
  "private": true,
  "author": "MhmdMK277",
  "license": "MIT",
  "main": "./server/main.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,ui -c cyan,magenta \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:ui": "vite",
    "start": "tsx server/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "fixtures": "python fixtures/generate.py && python fixtures/expected-python.py",
    "crossvalidate": "tsx scripts/crossvalidate.ts",
    "probe": "tsx scripts/probe-once.ts",
    "prove-stall": "python scripts/prove-stall.py",
    "prove-observer-lag": "tsx scripts/prove-observer-lag.ts",
    "prove-rotation": "tsx scripts/prove-rotation.ts",
    "prove-restart": "tsx scripts/prove-restart.ts",
    "prove-addresses": "tsx scripts/prove-addresses.ts",
    "prove-host-lag": "tsx scripts/prove-host-lag.ts",
    "preview-states": "tsx scripts/preview-states.tsx",
    "prove-websocket": "tsx scripts/prove-websocket.ts",
    "prove-console-noise": "tsx scripts/prove-console-noise.ts",
    "prove-portability": "tsx scripts/prove-portability.tsx",
    "diagnose-pause": "tsx scripts/diagnose-pause.ts",
    "prove-auth": "tsx scripts/prove-auth.ts",
    "prove-authgate": "tsx scripts/prove-authgate.ts",
    "prove-attach": "tsx scripts/prove-attach.ts",
    "prove-scan": "tsx scripts/prove-scan.ts",
    "prove-history": "tsx scripts/prove-history.ts",
    "prove-creation": "tsx scripts/prove-creation.ts",
    "prove-creation-route": "tsx scripts/prove-creation-route.ts",
    "accept-creation": "tsx scripts/accept-creation.ts",
    "prove-tunnel": "tsx scripts/prove-tunnel.ts",
    "prove-tunnel-route": "tsx scripts/prove-tunnel-route.ts",
    "accept-tunnel-preflight": "tsx scripts/accept-tunnel-preflight.ts",
    "package-release": "tsx scripts/package-release.ts",
    "accept-release": "tsx scripts/accept-release.ts",
    "scoop-manifest": "tsx scripts/scoop-manifest.ts",
    "audit-target": "tsx scripts/audit-target.ts",
    "prove-gclog": "tsx scripts/prove-gclog.ts",
    "prove-backup-policy": "tsx scripts/prove-backup-policy.ts",
    "prove-backup-route": "tsx scripts/prove-backup-route.ts",
    "prove-backup-detect": "tsx scripts/prove-backup-detect.ts",
    "prove-cold-backup": "tsx scripts/prove-cold-backup.ts",
    "prove-settings": "tsx scripts/prove-settings.ts",
    "prove-identity": "tsx scripts/prove-identity.ts",
    "prove-concurrent-start": "tsx scripts/prove-concurrent-start.ts",
    "prove-control": "tsx scripts/prove-control.ts",
    "prove-boottime": "tsx scripts/prove-boottime.ts",
    "prove-live-start": "tsx scripts/prove-live-start.ts"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
